page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf0 0%, #fffdf8 42%, #f8f4ea 100%);
  color: #5d5a58;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 36rpx 32rpx 56rpx;
  background: linear-gradient(180deg, #fffaf0 0%, #fffdf8 42%, #f8f4ea 100%);
}

.section {
  margin-bottom: 32rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: rgba(255, 252, 245, 0.86);
  color: #5d5a58;
  font-size: 34rpx;
  box-shadow: 0 8rpx 22rpx rgba(69, 26, 3, 0.07);
}

.title {
  color: #5d5a58;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 8rpx;
  color: #8b8680;
  font-size: 26rpx;
  line-height: 1.5;
}

.card {
  padding: 30rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.15);
  border-radius: 30rpx;
  background: rgba(255, 252, 245, 0.86);
  box-shadow: 0 16rpx 36rpx rgba(69, 26, 3, 0.08);
}

.field-label {
  margin-bottom: 14rpx;
  color: #5d5a58;
  font-size: 30rpx;
  font-weight: 700;
}

.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.15);
  border-radius: 22rpx;
  background: rgba(232, 225, 216, 0.42);
  color: #5d5a58;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.55;
}

.primary-btn,
.ghost-btn,
.danger-btn {
  min-height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-btn {
  background: #b8860b;
  color: #fffcf5;
  box-shadow: 0 14rpx 28rpx rgba(184, 134, 11, 0.2);
}

.ghost-btn {
  border: 1rpx solid rgba(184, 134, 11, 0.18);
  background: rgba(255, 252, 245, 0.78);
  color: #5d5a58;
}

.danger-btn {
  background: #c75b5b;
  color: #ffffff;
}

.disabled {
  opacity: 0.55;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-width: 136rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.15);
  border-radius: 22rpx;
  background: rgba(255, 252, 245, 0.72);
  color: #8b8680;
  text-align: center;
  font-size: 25rpx;
  box-shadow: 0 8rpx 18rpx rgba(69, 26, 3, 0.04);
}

.chip.active {
  border-color: #b8860b;
  background: #b8860b;
  color: #fffcf5;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid > view {
  width: calc((100% - 20rpx) / 2);
}

.small-text {
  color: #a8a098;
  font-size: 24rpx;
  line-height: 1.5;
}

.result-image {
  width: 100%;
  height: 520rpx;
  border-radius: 20rpx;
  background: rgba(232, 225, 216, 0.45);
}

.sub-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.sub-image {
  width: 100%;
  height: 220rpx;
  border-radius: 18rpx;
  background: rgba(232, 225, 216, 0.45);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions button {
  flex: 1;
}

.empty {
  padding: 90rpx 24rpx;
  color: #a8a098;
  text-align: center;
  font-size: 28rpx;
}
