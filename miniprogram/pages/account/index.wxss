.account-card,
.unbind-card {
  margin-bottom: 28rpx;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.email-row {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid rgba(184, 134, 11, 0.12);
}

.account-row .field-label {
  margin-bottom: 0;
}

.account-value {
  color: #8b8680;
  font-size: 27rpx;
  text-align: right;
}

.warning {
  margin-bottom: 24rpx;
  color: #c75b5b;
}

.password-input {
  margin-bottom: 24rpx;
}

.logout-btn {
  margin-top: 28rpx;
}
