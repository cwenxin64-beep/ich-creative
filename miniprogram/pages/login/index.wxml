<view class="page">
  <view class="header">
    <button class="back" bindtap="goBack">‹</button>
    <view>
      <view class="title">登录</view>
      <view class="subtitle">继续你的非遗创作</view>
    </view>
  </view>

  <view class="card form">
    <view class="section">
      <view class="field-label">邮箱</view>
      <input class="input" type="text" value="{{email}}" placeholder="请输入邮箱" bindinput="onEmail" />
    </view>

    <view class="section">
      <view class="field-label">密码</view>
      <input class="input" password value="{{password}}" placeholder="请输入密码" bindinput="onPassword" />
    </view>

    <button class="primary-btn {{loading ? 'disabled' : ''}}" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">
      {{loading ? '登录中' : '登录'}}
    </button>
  </view>

  <button class="ghost-btn link-btn" bindtap="goRegister">还没有账号，去注册</button>
</view>
