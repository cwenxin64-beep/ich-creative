.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.toolbar-btn {
  flex: 1;
}

.favorite-card {
  margin-bottom: 22rpx;
}

.favorite-main {
  display: flex;
  gap: 20rpx;
}

.thumb,
.placeholder,
.music-cover {
  width: 180rpx;
  height: 180rpx;
  flex: 0 0 180rpx;
  border-radius: 20rpx;
  background: rgba(232, 225, 216, 0.45);
}

.placeholder,
.music-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8860b;
  font-size: 56rpx;
  font-weight: 700;
}

.favorite-info {
  flex: 1;
  min-width: 0;
}

.favorite-title {
  margin-bottom: 14rpx;
  color: #5d5a58;
  font-size: 32rpx;
  font-weight: 700;
}

.sub-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.sub-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: rgba(232, 225, 216, 0.45);
}
