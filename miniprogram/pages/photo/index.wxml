<view class="page">
  <view class="header">
    <view>
      <view class="title">拍非遗</view>
      <view class="subtitle">上传或拍摄图片，生成非遗风格创意图片</view>
    </view>
  </view>

  <view class="card section">
    <view wx:if="{{!selectedImage}}">
      <view class="upload-actions">
        <button class="upload-choice" data-source="album" bindtap="chooseImage">
          <view class="upload-icon">
            <view class="upload-symbol album-symbol">
              <view class="album-sun"></view>
              <view class="album-mountain main"></view>
              <view class="album-mountain sub"></view>
            </view>
          </view>
          <view class="upload-title">选择图片</view>
          <view class="small-text">从相册选择</view>
        </button>
        <button class="upload-choice" data-source="camera" bindtap="chooseImage">
          <view class="upload-icon">
            <view class="upload-symbol camera-symbol">
              <view class="camera-bump"></view>
              <view class="camera-dot"></view>
              <view class="camera-lens"></view>
            </view>
          </view>
          <view class="upload-title">拍照</view>
          <view class="small-text">直接打开相机</view>
        </button>
      </view>
    </view>

    <view wx:else>
      <image class="preview" src="{{selectedImage}}" mode="aspectFill" />
      <view class="image-actions">
        <button class="ghost-btn" data-source="camera" bindtap="chooseImage">继续拍摄</button>
        <button class="ghost-btn" data-source="album" bindtap="chooseImage">从相册换图</button>
      </view>
    </view>
  </view>

  <view class="card section option-section">
    <view class="field-label">创意描述</view>
    <textarea class="textarea" value="{{description}}" placeholder="例如：将剪纸元素融入现代手机壳设计" bindinput="onDescription" />
    <view class="prompt-tools">
      <button class="prompt-optimize-btn {{loading || optimizing ? 'disabled' : ''}}" loading="{{optimizing}}" disabled="{{loading || optimizing}}" bindtap="optimizeDescription">AI 优化描述</button>
    </view>
  </view>

  <button class="primary-btn {{loading || !selectedImage ? 'disabled' : ''}}" loading="{{loading}}" disabled="{{loading || !selectedImage}}" bindtap="generate">
    {{loading ? '生成中 ' + progress + '%' : '开始创作'}}
  </button>

  <view wx:if="{{loading}}" class="card progress-card">
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{progress}}%;"></view>
    </view>
    <view class="small-text">正在生成，通常需要 30-60 秒。</view>
  </view>

  <view wx:if="{{result}}" class="section result-block">
    <view class="title small-title">生成结果</view>
    <view class="card">
      <view wx:if="{{result.staticMainImageUrl}}" class="view-frame">
        <image class="result-image" src="{{result.staticMainImageUrl}}" mode="aspectFit" data-url="{{result.staticMainImageUrl}}" bindtap="previewImage" />
        <view class="view-label">主视图</view>
      </view>
      <view class="sub-images">
        <view wx:if="{{result.staticSubImageUrl1}}" class="sub-view-frame">
          <image class="sub-image" src="{{result.staticSubImageUrl1}}" mode="aspectFill" data-url="{{result.staticSubImageUrl1}}" bindtap="previewImage" />
          <view class="view-label">侧面/场景</view>
        </view>
        <view wx:if="{{result.staticSubImageUrl2}}" class="sub-view-frame">
          <image class="sub-image" src="{{result.staticSubImageUrl2}}" mode="aspectFill" data-url="{{result.staticSubImageUrl2}}" bindtap="previewImage" />
          <view class="view-label">细节图</view>
        </view>
      </view>
      <view wx:if="{{result.analysis}}" class="analysis">
        <view class="field-label">作品介绍</view>
        <view class="small-text">元素：{{analysisText}}</view>
        <view wx:if="{{result.analysis.emotionalTone}}" class="small-text">情感：{{result.analysis.emotionalTone}}</view>
      </view>
      <view class="actions">
        <button class="ghost-btn" bindtap="toggleFavorite">{{isFavorited ? '已收藏' : '收藏'}}</button>
        <button class="ghost-btn" bindtap="goDetail">查看详情</button>
        <button class="ghost-btn" open-type="share">分享</button>
      </view>
      <view class="next-actions">
        <button class="ghost-btn" data-source="camera" bindtap="chooseImage">继续拍摄</button>
        <button class="ghost-btn" bindtap="resetAll">重新开始</button>
      </view>
    </view>
  </view>
</view>
