.option-section {
  margin-bottom: 24rpx;
}

.upload-actions {
  display: flex;
  gap: 20rpx;
}

.upload-choice {
  flex: 1;
  min-height: 260rpx;
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: rgba(232, 225, 216, 0.38);
}

.upload-title {
  margin-bottom: 12rpx;
  color: #5d5a58;
  font-size: 30rpx;
  font-weight: 700;
}

.upload-icon {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: rgba(184, 134, 11, 0.12);
  color: #b8860b;
}

.upload-symbol {
  position: relative;
  color: currentColor;
}

.album-symbol {
  width: 46rpx;
  height: 38rpx;
  overflow: hidden;
  border: 4rpx solid currentColor;
  border-radius: 10rpx;
}

.album-sun {
  position: absolute;
  right: 8rpx;
  top: 7rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.album-mountain {
  position: absolute;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  border-radius: 4rpx 0 0 0;
  transform: rotate(45deg);
}

.album-mountain.main {
  left: 9rpx;
  bottom: -3rpx;
  width: 25rpx;
  height: 25rpx;
}

.album-mountain.sub {
  right: 5rpx;
  bottom: 2rpx;
  width: 17rpx;
  height: 17rpx;
}

.camera-symbol {
  width: 52rpx;
  height: 38rpx;
  border: 4rpx solid currentColor;
  border-radius: 12rpx;
}

.camera-bump {
  position: absolute;
  left: 13rpx;
  top: -12rpx;
  width: 22rpx;
  height: 12rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: currentColor;
}

.camera-dot {
  position: absolute;
  right: 7rpx;
  top: 7rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: currentColor;
}

.camera-lens {
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.preview {
  width: 100%;
  height: 460rpx;
  border-radius: 20rpx;
  background: rgba(232, 225, 216, 0.42);
}

.image-actions,
.next-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.image-actions button,
.next-actions button {
  flex: 1;
}

.progress-card {
  margin-top: 22rpx;
}

.progress-bar {
  height: 16rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(232, 225, 216, 0.6);
}

.progress-inner {
  height: 100%;
  border-radius: 8rpx;
  background: #b8860b;
}

.result-block {
  margin-top: 36rpx;
}

.small-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
}

.analysis {
  margin-top: 22rpx;
}
