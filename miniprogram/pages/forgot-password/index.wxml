<view class="page">
  <view class="header">
    <button class="back" bindtap="goBack">‹</button>
    <view>
      <view class="title">找回账号</view>
      <view class="subtitle">通过绑定邮箱重置密码</view>
    </view>
  </view>

  <view class="card form">
    <view class="section">
      <view class="field-label">绑定邮箱</view>
      <input class="input" type="text" value="{{email}}" placeholder="请输入注册邮箱" bindinput="onEmail" />
    </view>

    <button class="ghost-btn {{sending ? 'disabled' : ''}}" loading="{{sending}}" disabled="{{sending}}" bindtap="requestCode">
      {{codeSent ? '重新发送验证码' : '发送验证码'}}
    </button>

    <block wx:if="{{codeSent}}">
      <view class="section reset-fields">
        <view class="field-label">邮箱验证码</view>
        <input class="input" type="number" maxlength="6" value="{{code}}" placeholder="请输入6位验证码" bindinput="onCode" />
      </view>
      <view class="section">
        <view class="field-label">新密码</view>
        <input class="input" password value="{{newPassword}}" placeholder="至少6位" bindinput="onNewPassword" />
      </view>
      <button class="primary-btn {{resetting ? 'disabled' : ''}}" loading="{{resetting}}" disabled="{{resetting}}" bindtap="resetPassword">
        重置密码
      </button>
    </block>
  </view>

  <button class="ghost-btn link-btn" bindtap="goLogin">返回登录</button>
</view>
