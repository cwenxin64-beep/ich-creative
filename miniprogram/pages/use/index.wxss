.option-section {
  margin-bottom: 24rpx;
}

.customize-btn {
  margin-top: 20rpx;
}

.order-panel {
  margin-bottom: 24rpx;
}

.order-head,
.order-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.small-btn {
  min-width: 136rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.order-list {
  margin-bottom: 36rpx;
}

.order-card {
  margin-bottom: 24rpx;
}

.order-title {
  flex: 1;
  color: #5d5a58;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.status-badge {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(184, 134, 11, 0.14);
  color: #b8860b;
  font-size: 22rpx;
  font-weight: 700;
}

.status-badge.accepted {
  background: rgba(123, 160, 91, 0.16);
  color: #6f924f;
}

.order-desc {
  margin-top: 18rpx;
  color: #5d5a58;
  font-size: 28rpx;
  line-height: 1.6;
}

.order-reference,
.selected-reference {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.14);
  border-radius: 20rpx;
  background: rgba(255, 252, 245, 0.74);
}

.reference-thumb {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: rgba(232, 225, 216, 0.45);
}

.reference-info {
  min-width: 0;
  flex: 1;
}

.reference-title {
  color: #5d5a58;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.order-meta {
  margin: 18rpx 0 10rpx;
  color: #8b8680;
  font-size: 24rpx;
  line-height: 1.4;
}

.order-action {
  margin-top: 22rpx;
}

.order-form {
  margin-top: 24rpx;
}

.form-input {
  margin-bottom: 18rpx;
}

.reference-picker {
  margin-bottom: 18rpx;
}

.reference-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.clear-reference {
  flex: 0 0 auto;
  min-width: 108rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.reference-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.reference-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.reference-option {
  width: 184rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.14);
  border-radius: 20rpx;
  background: rgba(255, 252, 245, 0.74);
}

.reference-option.active {
  border-color: #b8860b;
  background: rgba(184, 134, 11, 0.12);
}

.reference-option-image {
  width: 160rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: rgba(232, 225, 216, 0.45);
}

.reference-option-title,
.reference-source {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reference-option-title {
  margin-top: 10rpx;
  color: #5d5a58;
  font-size: 24rpx;
  font-weight: 700;
}

.reference-source {
  margin-top: 6rpx;
  color: #a8a098;
  font-size: 22rpx;
}

.progress-card {
  margin-top: 22rpx;
}

.progress-bar {
  height: 16rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(232, 225, 216, 0.6);
}

.progress-inner {
  height: 100%;
  border-radius: 8rpx;
  background: #b8860b;
}

.result-block {
  margin-top: 36rpx;
}

.small-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
}

.result-card {
  margin-bottom: 24rpx;
}

.result-type {
  margin-bottom: 18rpx;
  color: #8b8680;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-mini {
  padding: 80rpx 0;
  border-radius: 20rpx;
  background: rgba(232, 225, 216, 0.45);
  color: #a8a098;
  text-align: center;
}
