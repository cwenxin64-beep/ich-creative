<view class="page">
  <view class="header">
    <view>
      <view class="title">唱非遗</view>
      <view class="subtitle">描述创意，生成非遗风格音乐</view>
    </view>
  </view>

  <view class="card section option-section">
    <view class="field-label">音乐描述</view>
    <textarea class="textarea" value="{{prompt}}" placeholder="例如：一首关于端午龙舟的国风纯音乐" bindinput="onPrompt" />
  </view>

  <view class="card section option-section">
    <view class="field-label">曲风</view>
    <view class="chips">
      <view wx:for="{{genres}}" wx:key="*this" class="chip {{selectedGenre == item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectGenre">{{item}}</view>
    </view>
  </view>

  <view class="card section option-section">
    <view class="field-label">情绪</view>
    <view class="chips">
      <view wx:for="{{moods}}" wx:key="*this" class="chip {{selectedMood == item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectMood">{{item}}</view>
    </view>
  </view>

  <view class="card section option-section">
    <view class="field-label">时长</view>
    <view class="chips">
      <view wx:for="{{durations}}" wx:key="value" class="chip {{selectedDuration == item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectDuration">{{item.label}}</view>
    </view>
  </view>

  <button class="primary-btn {{loading ? 'disabled' : ''}}" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">
    {{loading ? '生成中 ' + progress + '%' : '开始创作'}}
  </button>

  <view wx:if="{{loading}}" class="card progress-card">
    <view class="progress-bar">
      <view class="progress-inner" style="width: {{progress}}%;"></view>
    </view>
    <view class="small-text">正在创作音乐，通常需要 1-3 分钟。</view>
  </view>

  <view wx:if="{{result}}" class="section result-block">
    <view class="title small-title">生成结果</view>
    <view class="card music-card">
      <view class="music-cover">♪</view>
      <view class="music-info">
        <view class="music-title">非遗音乐作品</view>
        <view class="small-text">时长：{{result.duration}} 秒</view>
        <view class="small-text">曲风：{{result.genre || selectedGenre || '未返回'}}</view>
      </view>
      <button class="primary-btn play-btn" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</button>
      <view wx:if="{{result.captions && result.captions !== '{}'}}" class="caption">{{result.captions}}</view>
      <view class="actions">
        <button class="ghost-btn" bindtap="toggleFavorite">{{isFavorited ? '已收藏' : '收藏'}}</button>
        <button class="ghost-btn" bindtap="goDetail">详情</button>
        <button class="ghost-btn" open-type="share">分享</button>
      </view>
    </view>
  </view>
</view>
